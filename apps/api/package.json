{
  "name": "@scopehatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "check": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "node --experimental-transform-types src/index.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.11.11"
  }
}
