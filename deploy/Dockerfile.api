# Build context = repo root. Root npm workspace and lockfile are integration dependencies.
FROM node:22.23.4-bookworm-slim AS development
ENV NPM_CONFIG_CACHE=/tmp/.npm
WORKDIR /app
COPY . .
RUN npm ci --no-audit --no-fund
USER node
EXPOSE 3000
ENTRYPOINT ["node", "deploy/scripts/service-entrypoint.mjs"]
CMD ["api-dev"]

FROM development AS builder
USER root
RUN npm run build --workspace @scopehatch/api

FROM node:22.23.4-bookworm-slim AS runtime
ENV NODE_ENV=production NPM_CONFIG_CACHE=/tmp/.npm
WORKDIR /app
COPY --from=builder --chown=node:node /app /app
RUN npm prune --omit=dev --no-audit --no-fund && rm -rf /tmp/.npm
USER node
EXPOSE 3000
ENTRYPOINT ["node", "deploy/scripts/service-entrypoint.mjs"]
CMD ["api"]
