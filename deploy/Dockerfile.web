# Vite build output must be apps/web/dist; workspace wiring pending integrator.
FROM node:22-bookworm-slim AS development
ENV NPM_CONFIG_CACHE=/tmp/.npm
WORKDIR /app
COPY . .
RUN npm ci --no-audit --no-fund
USER node
EXPOSE 5173
CMD ["npm", "run", "dev", "--workspace", "@scopehatch/web", "--", "--host", "0.0.0.0"]

FROM development AS builder
USER root
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_AUTHORIZATION_ENDPOINT
ARG VITE_OIDC_TOKEN_ENDPOINT
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_AUTHORIZATION_ENDPOINT=$VITE_OIDC_AUTHORIZATION_ENDPOINT
ENV VITE_OIDC_TOKEN_ENDPOINT=$VITE_OIDC_TOKEN_ENDPOINT
RUN npm run build --workspace @scopehatch/web

FROM nginxinc/nginx-unprivileged:1.28-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
