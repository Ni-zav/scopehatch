# Copy to .env; never commit .env or deploy/secrets/.
COMPOSE_PROJECT_NAME=scopehatch
POSTGRES_DB=scopehatch
POSTGRES_ADMIN_USER=scopehatch_admin
POSTGRES_RUNTIME_USER=scopehatch_runtime
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
WEB_DEV_PORT=5173
API_DEV_PORT=3000
# Replace with a trusted issuer / OIDC setup. Never authenticate using custom role headers.
OIDC_ISSUER=https://issuer.example.invalid/
OIDC_AUDIENCE=scopehatch-api
OIDC_JWKS_URI=https://issuer.example.invalid/.well-known/jwks.json
# Public SPA Authorization Code + PKCE client; never put client secrets here.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUTHORIZATION_ENDPOINT=
VITE_OIDC_TOKEN_ENDPOINT=
# fixture | ollama | openai-compatible
SCOPEHATCH_INFERENCE_PROVIDER=fixture
SCOPEHATCH_INFERENCE_BASE_URL=
SCOPEHATCH_INFERENCE_MODEL=
# Explicitly allowlisted hostname(s), not derived from the target URL. Comma-separated.
SCOPEHATCH_INFERENCE_ALLOWED_HOSTS=
# For single-tenant hosted API keys, lock use to this tenant; empty disables hosted calls.
SCOPEHATCH_INFERENCE_TENANT_ID=
REDIS_URL=
