{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted scope proposal (non-authoritative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_type",
    "deliverables",
    "unknowns"
  ],
  "properties": {
    "project_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
