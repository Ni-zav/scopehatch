{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client brief intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "project_id",
    "text"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "attachment_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
